  campaignId          String
  campaign            KeywordAuditCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  pageId              String?
  url                 String               @db.Text
  normalizedUrl       String               @db.VarChar(512)
  title               String?              @db.VarChar(512)
  totalScore          Int
  intentMatch         String               @default("weak")
  isBestCandidate     Boolean              @default(false)
  isTargetUrl         Boolean              @default(false)
  cannibalRisk        String?
  breakdownJson       Json                 @default("[]")
  missingJson         Json                 @default("[]")
  recommendationsJson Json                 @default("[]")
  createdAt           DateTime             @default(now())

  @@unique([campaignId, normalizedUrl])
  @@index([campaignId, totalScore])
}

// ─── Local SEO Presence ─────────────────────────────────────────────────────

model LocalBusinessProfile {
  id                       String   @id @default(cuid())
  clientId                 String
  client                   Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  websiteId                String?
  website                  Website? @relation(fields: [websiteId], references: [id], onDelete: SetNull)
  businessName             String   @db.VarChar(180)
  domain                   String   @db.VarChar(255)
  phone                    String   @db.VarChar(80)
  address                  String   @db.VarChar(255)
  city                     String   @db.VarChar(120)
  region                   String?  @db.VarChar(120)
  country                  String   @db.VarChar(120)
  postalCode               String?  @db.VarChar(40)
  mainCategory             String   @db.VarChar(160)
  services                 Json     @default("[]")
  targetLocations          Json     @default("[]")
  googleBusinessProfileUrl String?  @db.VarChar(512)
  googleAverageRating      Float?
  googleReviewCount        Int?
  latitude                 Float?
  longitude                Float?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  keywords        LocalKeyword[]
  competitors     LocalCompetitor[]
  reviews         LocalReview[]
  citations       LocalCitation[]
  scores          LocalScore[]
  recommendations LocalRecommendation[]

  @@index([clientId])
  @@index([websiteId])
  @@index([domain])
}

model LocalKeyword {
  id         String               @id @default(cuid())
  businessId String
  business   LocalBusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)
  keyword    String               @db.VarChar(255)
  city       String               @db.VarChar(120)
  country    String               @default("United States") @db.VarChar(120)
  device     String               @default("desktop") @db.VarChar(32)
  language   String               @default("en") @db.VarChar(16)
  active     Boolean              @default(true)
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  snapshots          LocalRankSnapshot[]
  scores             LocalScore[]
  competitors        LocalCompetitor[]
  gridConfigurations LocalGridConfiguration[]

  @@index([businessId])
  @@index([keyword, city])
}

model LocalRankSnapshot {
  id                  String       @id @default(cuid())
  keywordId           String
  keyword             LocalKeyword @relation(fields: [keywordId], references: [id], onDelete: Cascade)
  scanDate            DateTime     @default(now())
  organicPosition     Int?
  mapsPosition        Int?
  localPackPosition   Int?
  foundDomain         Boolean      @default(false)
  matchedBusinessName String?      @db.VarChar(180)
  confidenceScore     Int          @default(0)
  matchStatus         String       @default("no_reliable_match") @db.VarChar(40)
  rawResponseRef      String?      @db.VarChar(255)
  evidenceJson        Json         @default("{}")

  @@index([keywordId, scanDate])
}

model LocalGridConfiguration {
  id                String       @id @default(cuid())
  keywordId         String
  keyword           LocalKeyword @relation(fields: [keywordId], references: [id], onDelete: Cascade)
  name              String       @db.VarChar(180)
  gridSize          Int          @default(7)
  radiusKm          Float        @default(5)
  centerLatitude    Float
  centerLongitude   Float
  device            String       @default("mobile") @db.VarChar(32)
  language          String       @default("en") @db.VarChar(16)
  engine            String       @default("google_maps") @db.VarChar(40)
  resultDepth       Int          @default(20)
  schedule          String       @default("monthly") @db.VarChar(40)
  movementThreshold Float        @default(10)
  active            Boolean      @default(true)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  scans LocalGridScan[]

  @@index([keywordId, active])
}

model LocalGridScan {
  id              String                 @id @default(cuid())
  configurationId String
  configuration   LocalGridConfiguration @relation(fields: [configurationId], references: [id], onDelete: Cascade)
  status          String                 @default("queued") @db.VarChar(40)
  scanDate        DateTime               @default(now())
  averageRank     Float?
  top3Share       Float?
  top10Share      Float?
  weakAreaCount   Int                    @default(0)
  summaryJson     Json                   @default("{}")
  errorMessage    String?                @db.Text
  completedAt     DateTime?
  createdAt       DateTime               @default(now())

  points      LocalGridPoint[]
  competitors LocalGridCompetitor[]

  @@index([configurationId, scanDate])
  @@index([status, scanDate])
}

model LocalGridPoint {
  id           String        @id @default(cuid())
  scanId       String
  scan         LocalGridScan @relation(fields: [scanId], references: [id], onDelete: Cascade)
  rowIndex     Int
  columnIndex  Int
  latitude     Float
  longitude    Float
  rank         Int?
  found        Boolean       @default(false)
  matchedName  String?       @db.VarChar(180)
  confidence   Int           @default(0)
  evidenceJson Json          @default("{}")

  @@unique([scanId, rowIndex, columnIndex])
  @@index([scanId, rank])
}

model LocalGridCompetitor {
  id           String        @id @default(cuid())
  scanId       String
  scan         LocalGridScan @relation(fields: [scanId], references: [id], onDelete: Cascade)
  businessName String        @db.VarChar(180)
  domain       String?       @db.VarChar(255)
  averageRank  Float?
  top3Share    Float?
  top10Share   Float?
  evidenceJson Json          @default("{}")

  @@index([scanId, averageRank])
}

model LocalCompetitor {
  id              String               @id @default(cuid())
  businessId      String
  business        LocalBusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)
  keywordId       String?
  keyword         LocalKeyword?        @relation(fields: [keywordId], references: [id], onDelete: SetNull)
  competitorName  String               @db.VarChar(180)
  domain          String?              @db.VarChar(255)
  phone           String?              @db.VarChar(80)
  address         String?              @db.VarChar(255)
  rating          Float?
  reviewCount     Int?
  mapsPosition    Int?
  organicPosition Int?
  categoriesJson  Json                 @default("[]")
  evidenceJson    Json                 @default("{}")
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([businessId])
  @@index([keywordId])
  @@index([domain])
}

model LocalReview {
  id          String               @id @default(cuid())
  businessId  String
  business    LocalBusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)
  source      String               @db.VarChar(80)
  reviewer    String?              @db.VarChar(180)
  rating      Float?
  reviewText  String?              @db.Text
  reviewDate  DateTime?
  sentiment   String?              @db.VarChar(40)
  replyStatus String               @default("not_replied") @db.VarChar(40)
  createdAt   DateTime             @default(now())

  @@index([businessId])
  @@index([source])
  @@index([reviewDate])
}

model LocalCitation {
  id           String               @id @default(cuid())
  businessId   String
  business     LocalBusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)
  source       String               @db.VarChar(120)
  found        Boolean              @default(false)
  nameMatch    Boolean              @default(false)
  phoneMatch   Boolean              @default(false)
  addressMatch Boolean              @default(false)
  websiteMatch Boolean              @default(false)
  status       String               @default("missing") @db.VarChar(40)
  fixUrl       String?              @db.VarChar(512)
  notes        String?              @db.Text
  checkedAt    DateTime             @default(now())

  @@unique([businessId, source])
  @@index([businessId])
}

model LocalScore {
  id           String               @id @default(cuid())
  businessId   String
  business     LocalBusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)
  keywordId    String?
  keyword      LocalKeyword?        @relation(fields: [keywordId], references: [id], onDelete: SetNull)
  scoreDate    DateTime             @default(now())
  totalScore   Int
  organicScore Int                  @default(0)
  mapsScore    Int                  @default(0)
  packScore    Int                  @default(0)
  reviewScore  Int                  @default(0)
  napScore     Int                  @default(0)
  websiteScore Int                  @default(0)
  contentScore Int                  @default(0)
  statusLabel  String               @db.VarChar(40)
  evidenceJson Json                 @default("{}")

  @@index([businessId, scoreDate])
  @@index([keywordId, scoreDate])
}

model LocalRecommendation {
  id             String               @id @default(cuid())
  businessId     String
  business       LocalBusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)
  priority       String               @db.VarChar(20)
  category       String               @db.VarChar(80)
  recommendation String               @db.Text
  expectedImpact String?              @db.Text
  status         String               @default("open") @db.VarChar(40)
  evidenceJson   Json                 @default("{}")
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([businessId, status])
  @@index([priority])
}

model ExternalApiCache {
  id           String   @id @default(cuid())
  provider     String   @db.VarChar(80)
  endpoint     String   @db.VarChar(180)
  cacheKey     String   @unique @db.VarChar(255)
  requestJson  Json     @default("{}")
  responseJson Json     @default("{}")
  status       String   @default("ok") @db.VarChar(40)
  fetchedAt    DateTime @default(now())
  expiresAt    DateTime

  @@index([provider, endpoint])
  @@index([expiresAt])
}

// ─── Keyword & Competitor Intelligence ───────────────────────────────────────

model KeywordResearchRun {
  id                   String    @id @default(cuid())
  requestKey           String?   @db.VarChar(64)
  clientId             String
  client               Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  websiteId            String?
  website              Website?  @relation(fields: [websiteId], references: [id], onDelete: SetNull)
  projectId            String?
  project              Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  seedKeyword          String    @db.VarChar(255)
  targetUrl            String?   @db.VarChar(512)
  targetDomain         String?   @db.VarChar(255)
  targetRank           Int?
  rankingUrl           String?   @db.Text
  rankFoundDepth       Int?
  manualRank           Int?
  manualPage           Int?
  manualPosition       Int?
  manualUrl            String?   @db.Text
  manualNote           String?   @db.Text
  manualObservedAt     DateTime?
  locationName         String    @default("United States") @db.VarChar(120)
  languageCode         String    @default("en") @db.VarChar(16)
  device               String    @default("desktop") @db.VarChar(32)
  serpDepth            Int       @default(10)
  status               String    @default("completed")
  source               String    @default("search_data")
  keywordCount         Int       @default(0)
  competitorCount      Int       @default(0)
  averageVolume        Int?
  competitorsAboveJson Json      @default("[]")
  error                String?   @db.Text
  createdAt            DateTime  @default(now())
  completedAt          DateTime?

  ideas       KeywordIdea[]
  competitors KeywordSerpCompetitor[]

  @@index([clientId])
  @@index([requestKey])
  @@index([websiteId])
  @@index([projectId])
  @@index([createdAt])
}

model KeywordIdea {
  id                 String             @id @default(cuid())
  runId              String
  run                KeywordResearchRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  keyword            String             @db.VarChar(512)
  avgMonthlySearches Int?
  competition        String?
  competitionIndex   Int?
  cpc                Float?
  lowTopOfPageBid    Float?
  highTopOfPageBid   Float?
  currency           String?
  source             String             @default("search_data")
  rawJson            Json               @default("{}")
  createdAt          DateTime           @default(now())

  @@index([runId])
  @@index([keyword])
}

model KeywordSerpCompetitor {
  id                  String             @id @default(cuid())
  runId               String
  run                 KeywordResearchRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  rank                Int
  url                 String             @db.Text
  domain              String             @db.VarChar(255)
  title               String?            @db.Text
  description         String?            @db.Text
  fetchStatus         Int?
  contentTitle        String?            @db.Text
  metaDescription     String?            @db.Text
  h1Json              Json               @default("[]")
  h2Json              Json               @default("[]")
  schemaTypesJson     Json               @default("[]")
  wordCount           Int?
  faqCount            Int                @default(0)
  contentScore        Int?
  missingTopicsJson   Json               @default("[]")
  recommendationsJson Json               @default("[]")
  rawSerpJson         Json               @default("{}")
  createdAt           DateTime           @default(now())
  contentFetchedAt    DateTime?

  @@index([runId])
  @@index([domain])
}

// ─── AI Content Studio ───────────────────────────────────────────────────────

model AiContentGeneration {
  id               String    @id @default(cuid())
  clientId         String
  client           Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId           String?
  projectId        String?   @db.VarChar(191)
  websiteId        String?
  sourceContext    String?   @db.VarChar(80)
  sourceType       String?   @db.VarChar(80)
  sourceRecordId   String?   @db.VarChar(191)
  type             String    @db.VarChar(64) // article | title | meta_description | faq | schema | ai_search
  status           String    @default("completed") @db.VarChar(32)
  topic            String    @db.VarChar(512)
  targetKeyword    String?   @db.VarChar(255)
  targetUrl        String?   @db.VarChar(512)
  languageCode     String    @default("en") @db.VarChar(16)
  tone             String?   @db.VarChar(80)
  prompt           String    @db.Text
  resultJson       Json      @default("{}")
  model            String?   @db.VarChar(120)
  inputTokens      Int       @default(0)
  outputTokens     Int       @default(0)
  estimatedCostUsd Float?
  error            String?   @db.Text
  validatedAt      DateTime?
  createdAt        DateTime  @default(now())

  @@index([clientId, createdAt])
  @@index([projectId, sourceContext, sourceType, sourceRecordId, createdAt])
  @@index([websiteId])
  @@index([type])
}

model AiUsageCounter {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  periodStart DateTime
  type        String   @db.VarChar(64) // article | helper
  count       Int      @default(0)
  tokens      Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@unique([clientId, periodStart, type])
  @@index([clientId, periodStart])
}

// ─── Social Strategy & Brand Visibility ──────────────────────────────────────

model SocialProfile {
  id               String    @id @default(cuid())
  websiteId        String
  website          Website   @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  platform         String    @db.VarChar(40)
  profileUrl       String    @db.VarChar(512)
  handle           String?   @db.VarChar(120)
  displayName      String?   @db.VarChar(180)
  bio              String?   @db.Text
  followerCount    Int?
  postingFrequency String?   @db.VarChar(80)
  lastPostAt       DateTime?
  websiteLinked    Boolean   @default(false)
  profileComplete  Boolean   @default(false)
  brandConsistent  Boolean   @default(false)
  notes            String?   @db.Text
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([websiteId, platform])
  @@index([websiteId])
}

model SocialCompetitorProfile {
  id               String   @id @default(cuid())
  websiteId        String
  website          Website  @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  competitorName   String   @db.VarChar(180)
  competitorDomain String?  @db.VarChar(255)
  platform         String   @db.VarChar(40)
  profileUrl       String?  @db.VarChar(512)
  followerCount    Int?
  postingFrequency String?  @db.VarChar(80)
  engagementLevel  String?  @db.VarChar(80)
  contentThemes    Json     @default("[]")
  notes            String?  @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([websiteId])
  @@index([competitorDomain])
}

model SocialStrategy {
  id                          String    @id @default(cuid())
  websiteId                   String
  website                     Website   @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  projectId                   String?
  project                     Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  campaignName                String?   @db.VarChar(180)
  campaignStartAt             DateTime?
  campaignEndAt               DateTime?
  goalMetric                  String?   @db.VarChar(80)
  goalTarget                  Float?
  goal                        String    @db.VarChar(160)
  audience                    String?   @db.VarChar(255)
  platforms                   Json      @default("[]")
  postingFrequency            String?   @db.VarChar(120)
  tone                        String?   @db.VarChar(80)
  monthlyTheme                String?   @db.VarChar(255)
  status                      String    @default("draft") @db.VarChar(40)
  generationMode              String    @default("evidence_engine") @db.VarChar(60)
  strategySummary             String?   @db.Text
  platformRecommendationsJson Json      @default("[]")
  campaignThemesJson          Json      @default("[]")
  bestPostingTimesJson        Json      @default("[]")
  intelligenceSnapshotJson    Json      @default("{}")
  socialScore                 Int       @default(0)
  profileScore                Int       @default(0)
  consistencyScore            Int       @default(0)
  activityScore               Int       @default(0)
  competitorScore             Int       @default(0)
  seoAlignmentScore           Int       @default(0)
  recommendationsJson         Json      @default("[]")
  nextReviewAt                DateTime?
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  pillars            SocialContentPillar[]
  posts              SocialCalendarPost[]
  metrics            SocialPerformanceMetric[]
  repurposingBatches SocialRepurposingBatch[]

  @@index([websiteId])
  @@index([projectId, createdAt])
  @@index([projectId, status])
  @@index([createdAt])
}

model SocialContentPillar {
  id          String         @id @default(cuid())
  strategyId  String
  strategy    SocialStrategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  title       String         @db.VarChar(160)
  description String         @db.Text
  formatsJson Json           @default("[]")
  createdAt   DateTime       @default(now())

  @@index([strategyId])
}

model SocialCalendarPost {
  id                String         @id @default(cuid())
  strategyId        String
  strategy          SocialStrategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  platform          String         @db.VarChar(40)
  publishDate       DateTime
  topic             String         @db.VarChar(255)
  caption           String         @db.Text
  creativeDirection String?        @db.Text
  cta               String?        @db.VarChar(180)
  hashtagsJson      Json           @default("[]")
  imageSuggestion   String?        @db.Text
  targetKeyword     String?        @db.VarChar(255)
  targetUrl         String?        @db.VarChar(512)
  sourceType        String?        @db.VarChar(80)
  sourceId          String?        @db.VarChar(191)
  funnelStage       String         @default("awareness") @db.VarChar(60)
  status            String         @default("planned") @db.VarChar(40)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  metrics SocialPerformanceMetric[]

  @@index([strategyId])
  @@index([publishDate])
  @@index([sourceType, sourceId])
}

model SocialPerformanceMetric {
  id           String              @id @default(cuid())
  projectId    String
  project      Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  strategyId   String?
  strategy     SocialStrategy?     @relation(fields: [strategyId], references: [id], onDelete: SetNull)
  postId       String?
  post         SocialCalendarPost? @relation(fields: [postId], references: [id], onDelete: SetNull)
  platform     String              @db.VarChar(40)
  sourceType   String              @default("manual") @db.VarChar(60)
  externalId   String?             @db.VarChar(191)
  impressions  Int                 @default(0)
  reach        Int                 @default(0)
  engagements  Int                 @default(0)
  clicks       Int                 @default(0)
  leads        Int                 @default(0)
  conversions  Int                 @default(0)
  spend        Float?
  revenue      Float?
  evidenceJson Json                @default("{}")
  recordedAt   DateTime            @default(now())
  createdAt    DateTime            @default(now())

  @@index([projectId, recordedAt])
  @@index([strategyId, platform])
  @@index([postId, recordedAt])
  @@index([externalId])
}

model SocialRepurposingBatch {
  id                 String          @id @default(cuid())
  projectId          String
  project            Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  strategyId         String?
  strategy           SocialStrategy? @relation(fields: [strategyId], references: [id], onDelete: SetNull)
  sourceType         String          @db.VarChar(80)
  sourceId           String          @db.VarChar(191)
  sourceTitle        String          @db.VarChar(255)
  sourceUrl          String?         @db.VarChar(512)
  sourceSnapshotJson Json            @default("{}")
  keyMessagesJson    Json            @default("[]")
  targetChannelsJson Json            @default("[]")
  status             String          @default("draft") @db.VarChar(40)
  generationMode     String          @default("evidence_engine") @db.VarChar(60)
  createdByUserId    String?
  approvedByUserId   String?
  approvedAt         DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  assets SocialRepurposedAsset[]

  @@index([projectId, createdAt])
  @@index([strategyId, status])
  @@index([sourceType, sourceId])
}

model SocialRepurposedAsset {
  id                   String                 @id @default(cuid())
  batchId              String
  batch                SocialRepurposingBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  channel              String                 @db.VarChar(60)
  assetType            String                 @db.VarChar(80)
  title                String                 @db.VarChar(255)
  content              String                 @db.Text
  cta                  String?                @db.VarChar(255)
  hashtagsJson         Json                   @default("[]")
  visualSuggestion     String?                @db.Text
  status               String                 @default("draft") @db.VarChar(40)
  socialCalendarPostId String?                @db.VarChar(191)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@index([batchId, status])
  @@index([channel])
  @@index([socialCalendarPostId])
}
