// SEO + AI Search crawler — data model.
// See docs/ARCHITECTURE.md §9. PostgreSQL 17+ / Prisma.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth + tenancy (RBAC) ────────────────────────────────────────────────────
//
// Roles:
//  - super_admin : SEnuke AI staff. No clientId. Creates clients + client users,
//                  sees everything across all tenants.
//  - client_admin: belongs to one Client. Manages that client's websites, crawls,
//                  reports, and can invite client_users in the same client.
//  - client_user : belongs to one Client. Can run crawls + view reports, no user mgmt.
//
// Tenant isolation: every Website (and everything under it) is reached via clientId.
// Non-super_admin queries MUST be scoped to the user's clientId in the API layer.

enum Role {
  super_admin
  client_admin
  client_user
}

model User {
  id                      String                   @id @default(cuid())
  email                   String                   @unique
  passwordHash            String
  name                    String?
  role                    Role                     @default(client_user)
  // null for super_admin; required for client_* roles.
  clientId                String?
  client                  Client?                  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  isActive                Boolean                  @default(true)
  emailVerifiedAt         DateTime?
  lastLoginAt             DateTime?
  createdAt               DateTime                 @default(now())
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  workspaceMemberships    WorkspaceMembership[]
  ownedWorkspaces         Workspace[]              @relation("WorkspaceOwner")
  notifications           WorkspaceNotification[]
  activityEvents          WorkspaceActivity[]      @relation("ActivityActor")
  projectAgentThreads     ProjectAgentThread[]

  @@index([clientId])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Client {
  id                                 String                 @id @default(cuid())
  name                               String
  contactEmail                       String?
  plan                               String                 @default("mini")
  aiSubscriptionStatus               String                 @default("active")
  stripeCustomerId                   String?
  stripeSubscriptionId               String?
  trialStartedAt                     DateTime?
  trialEndsAt                        DateTime?
  manualAccessEndsAt                 DateTime?
  graceEndsAt                        DateTime?
  subscriptionSource                 String                 @default("trial") @db.VarChar(40)
  offlineAutoRenew                   Boolean                @default(false)
  offlineNextRenewalAt               DateTime?
  subscriptionCurrentPeriodEnd       DateTime?
  trialEndingSoonNotifiedAt          DateTime?
  trialExpiredNotifiedAt             DateTime?
  paymentFailedNotifiedAt            DateTime?
  manualAccessEndingSoonNotifiedAt   DateTime?
  manualAccessExpiredNotifiedAt      DateTime?
  subscriptionExpiringSoonNotifiedAt DateTime?
  reportEmailEnabled                 Boolean                @default(true)
  weeklyReportEmailEnabled           Boolean                @default(true)
  monthlyReportEmailEnabled          Boolean                @default(true)
  rankingChangeEmailEnabled          Boolean                @default(true)
  lastWeeklyReportAt                 DateTime?
  lastMonthlyUsageResetAt            DateTime?
  lastMonthlyAuditAt                 DateTime?
  lastMonthlyReportAt                DateTime?
  activeWebsiteLimit                 Int                    @default(1)
  extraWebsiteSlots                  Int                    @default(0)
  lastWebsiteReplacementAt           DateTime?
  isActive                           Boolean                @default(true)
  createdAt                          DateTime               @default(now())
  websites                           Website[]
  users                              User[]
  keywordResearchRuns                KeywordResearchRun[]
  aiContentGenerations               AiContentGeneration[]
  aiUsageCounters                    AiUsageCounter[]
  creditAccounts                     CreditAccount[]
  creditTransactions                 CreditTransaction[]
  usageEvents                        UsageEvent[]
  providerCostEvents                 ProviderCostEvent[]
  cacheRecords                       CacheRecord[]
  budgetCaps                         BudgetCap[]
  usageAlerts                        UsageAlert[]
  localBusinessProfiles              LocalBusinessProfile[]
  offlinePayments                    OfflinePayment[]
  monthlyReports                     MonthlyClientReport[]
  executionTasks                     ExecutionTask[]
  projects                           Project[]
  workspace                          Workspace?

  @@index([plan])
  @@index([aiSubscriptionStatus, manualAccessEndsAt])
  @@index([stripeCustomerId])
}

// Agency tenancy. Client above remains the legacy billing tenant during the
// migration; Workspace is the authorization and operational boundary.
model Workspace {
  id                      String   @id @default(cuid())
  legacyClientId          String?  @unique
  legacyClient            Client?  @relation(fields: [legacyClientId], references: [id], onDelete: SetNull)
  name                    String   @db.VarChar(180)
  workspaceType           String   @default("business") @db.VarChar(40)
  ownerUserId             String
  owner                   User     @relation("WorkspaceOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  status                  String   @default("active") @db.VarChar(40)
  settingsJson            Json     @default("{}")
  securitySettingsJson    Json     @default("{}")
  integrationSettingsJson Json     @default("{}")
  autoApprovalPolicyJson  Json     @default("{}")
  brandingJson            Json     @default("{}")
  defaultTemplatesJson    Json     @default("{}")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  memberships      WorkspaceMembership[]
  teams            WorkspaceTeam[]
  agencyClients    AgencyClient[]
  notifications    WorkspaceNotification[]
  activity         WorkspaceActivity[]
  invitations      WorkspaceInvitation[]
  agentThreads     ProjectAgentThread[]
  aiIntakeSessions WorkspaceAiIntakeSession[]

  @@index([ownerUserId])
  @@index([status])
}

model WorkspaceAiIntakeSession {
  id                    String    @id @default(cuid())
  workspaceId           String
  workspace             Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId                String
  contextType           String    @db.VarChar(40)
  mode                  String    @db.VarChar(30)
  websiteUrl            String?   @db.VarChar(512)
  websiteDomain         String?   @db.VarChar(255)
  status                String    @default("running") @db.VarChar(40)
  pagesAnalyzed         Json      @default("[]")
  inputJson             Json      @default("{}")
  suggestionsJson       Json      @default("{}")
  evidenceJson          Json      @default("{}")
  reviewJson            Json      @default("{}")
  appliedProjectId      String?
  appliedAgencyClientId String?
  model                 String?   @db.VarChar(120)
  errorCode             String?   @db.VarChar(80)
  errorMessage          String?   @db.Text
  startedAt             DateTime  @default(now())
  completedAt           DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([workspaceId, createdAt])
  @@index([userId, createdAt])
  @@index([websiteDomain])
  @@index([status])
}

model WorkspaceInvitation {
  id                  String    @id @default(cuid())
  workspaceId         String
  workspace           Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email               String    @db.VarChar(180)
  normalizedEmail     String    @db.VarChar(180)
  name                String?   @db.VarChar(180)
  rolesJson           Json      @default("[]")
  teamIdsJson         Json      @default("[]")
  agencyClientIdsJson Json      @default("[]")
  permissionOverrides Json      @default("{}")
  tokenHash           String    @unique @db.VarChar(191)
  status              String    @default("invited") @db.VarChar(40)
  invitedByUserId     String
  expiresAt           DateTime
  acceptedAt          DateTime?
  revokedAt           DateTime?
  createdAt           DateTime  @default(now())

  @@index([workspaceId, status])
  @@index([workspaceId, normalizedEmail])
  @@index([expiresAt])
}

model WorkspaceMembership {
  id                  String    @id @default(cuid())
  workspaceId         String
  workspace           Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  status              String    @default("active") @db.VarChar(40)
  permissionOverrides Json      @default("{}")
  invitedAt           DateTime?
  joinedAt            DateTime?
  suspendedAt         DateTime?
  deactivatedAt       DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  roles              WorkspaceMemberRole[]
  teamMemberships    WorkspaceTeamMember[]
  clientAssignments  AgencyClientMember[]
  projectAssignments ProjectMemberAssignment[]
  assignedTasks      ExecutionTask[]           @relation("TaskAssignee")
  managedTasks       ExecutionTask[]           @relation("TaskManager")
  approvalTasks      ExecutionTask[]           @relation("TaskApprover")

  @@unique([workspaceId, userId])
  @@index([workspaceId, status])
  @@index([userId, status])
}

model WorkspaceMemberRole {
  id           String              @id @default(cuid())
  membershipId String
  membership   WorkspaceMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role         String              @db.VarChar(40)
  grantedById  String?
  createdAt    DateTime            @default(now())

  @@unique([membershipId, role])
  @@index([role])
}

model WorkspaceTeam {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String    @db.VarChar(180)
  description String?   @db.Text
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  members            WorkspaceTeamMember[]
  clientAssignments  AgencyClientTeam[]
  projectAssignments ProjectTeamAssignment[]
  assignedTasks      ExecutionTask[]

  @@unique([workspaceId, name])
  @@index([workspaceId, isActive])
}

model WorkspaceTeamMember {
  id           String              @id @default(cuid())
  teamId       String
  team         WorkspaceTeam       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  membershipId String
  membership   WorkspaceMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  createdAt    DateTime            @default(now())

  @@unique([teamId, membershipId])
  @@index([membershipId])
}

model AgencyClient {
  id                 String    @id @default(cuid())
  workspaceId        String
  workspace          Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name               String    @db.VarChar(180)
  normalizedName     String    @db.VarChar(180)
  status             String    @default("active") @db.VarChar(40)
  contactName        String?   @db.VarChar(180)
  contactEmail       String?   @db.VarChar(180)
  contactPhone       String?   @db.VarChar(80)
  websites           Json      @default("[]")
  businessLocations  Json      @default("[]")
  targetMarkets      Json      @default("[]")
  competitors        Json      @default("[]")
  brandingJson       Json      @default("{}")
  internalNotes      String?   @db.Text
  clientVisibleNotes String?   @db.Text
  defaultSettings    Json      @default("{}")
  archivedAt         DateTime?
  archivedById       String?
  createdById        String
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  projects          Project[]
  memberAssignments AgencyClientMember[]
  teamAssignments   AgencyClientTeam[]
  activity          WorkspaceActivity[]
  notifications     WorkspaceNotification[]

  @@unique([workspaceId, normalizedName])
  @@index([workspaceId, status])
}

model AgencyClientMember {
  id             String              @id @default(cuid())
  agencyClientId String
  agencyClient   AgencyClient        @relation(fields: [agencyClientId], references: [id], onDelete: Cascade)
  membershipId   String
  membership     WorkspaceMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  assignmentRole String?             @db.VarChar(40)
  createdAt      DateTime            @default(now())

  @@unique([agencyClientId, membershipId])
  @@index([membershipId])
}

model AgencyClientTeam {
  id             String        @id @default(cuid())
  agencyClientId String
  agencyClient   AgencyClient  @relation(fields: [agencyClientId], references: [id], onDelete: Cascade)
  teamId         String
  team           WorkspaceTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())

  @@unique([agencyClientId, teamId])
  @@index([teamId])
}

model ProjectMemberAssignment {
  id             String              @id @default(cuid())
  projectId      String
  project        Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  membershipId   String
  membership     WorkspaceMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  assignmentRole String?             @db.VarChar(40)
  createdAt      DateTime            @default(now())

  @@unique([projectId, membershipId])
  @@index([membershipId])
}

model ProjectTeamAssignment {
  id        String        @id @default(cuid())
  projectId String
  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  teamId    String
  team      WorkspaceTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@unique([projectId, teamId])
  @@index([teamId])
}

model WorkspaceNotification {
  id             String        @id @default(cuid())
  workspaceId    String
  workspace      Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  agencyClientId String?
  agencyClient   AgencyClient? @relation(fields: [agencyClientId], references: [id], onDelete: Cascade)
  projectId      String?
  type           String        @db.VarChar(80)
  title          String        @db.VarChar(255)
  body           String        @db.Text
  actionUrl      String?       @db.VarChar(512)
  emailEligible  Boolean       @default(true)
  emailStatus    String        @default("pending") @db.VarChar(40)
  readAt         DateTime?
  createdAt      DateTime      @default(now())

  @@index([userId, readAt, createdAt])
  @@index([workspaceId, createdAt])
  @@index([agencyClientId])
  @@index([projectId])
}

model WorkspaceActivity {
  id             String        @id @default(cuid())
  workspaceId    String
  workspace      Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actorUserId    String?
  actor          User?         @relation("ActivityActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  agencyClientId String?
  agencyClient   AgencyClient? @relation(fields: [agencyClientId], references: [id], onDelete: SetNull)
  projectId      String?
  action         String        @db.VarChar(100)
  entityType     String        @db.VarChar(80)
  entityId       String?       @db.VarChar(191)
  previousJson   Json?
  nextJson       Json?
  metadataJson   Json          @default("{}")
  createdAt      DateTime      @default(now())

  @@index([workspaceId, createdAt])
  @@index([agencyClientId, createdAt])
  @@index([projectId, createdAt])
  @@index([actorUserId, createdAt])
}

model OfflinePayment {
  id                 String    @id @default(cuid())
  clientId           String
  client             Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  amountCents        Int
  method             String    @db.VarChar(80)
  duration           String    @db.VarChar(20)
  reference          String?   @db.VarChar(255)
  notes              String?   @db.Text
  autoRenew          Boolean   @default(false)
  subscriptionEndsAt DateTime
  nextRenewalAt      DateTime?
  status             String    @default("recorded") @db.VarChar(40)
  createdAt          DateTime  @default(now())

  @@index([clientId, createdAt])
  @@index([subscriptionEndsAt])
}

model MonthlyClientReport {
  id          String    @id @default(cuid())
  clientId    String
  client      Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  periodStart DateTime
  status      String    @default("ready") @db.VarChar(40)
  summaryJson Json      @default("{}")
  emailSentAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([clientId, periodStart])
  @@index([periodStart])
}

model MaintenanceRun {
  id          String    @id @default(cuid())
  jobKey      String    @db.VarChar(120)
  status      String    @db.VarChar(40)
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  detailsJson Json      @default("{}")
  error       String?   @db.Text

  @@index([jobKey, startedAt])
  @@index([status])
}

model BillingPlan {
  id                 String   @id @default(cuid())
  code               String   @unique @db.VarChar(40)
  name               String   @db.VarChar(80)
  description        String   @db.Text
  priceMonthlyCents  Int
  articleLimit       Int
  helperMonthlyLimit Int      @default(1000)
  features           Json     @default("[]")
  stripeProductId    String?  @db.VarChar(255)
  stripePriceId      String?  @db.VarChar(255)
  isActive           Boolean  @default(true)
  sortOrder          Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@index([stripeProductId])
  @@index([stripePriceId])
}

// ─── Usage, Limits, Credits & Cost Control ──────────────────────────────────

model FeatureCostCatalog {
  id                    String   @id @default(cuid())
  featureKey            String   @unique @db.VarChar(120)
  moduleName            String   @db.VarChar(80)
  label                 String   @db.VarChar(180)
  description           String   @db.Text
  defaultCreditCost     Int      @default(0)
  estimatedProviderCost Float    @default(0)
  unitLabel             String   @default("run") @db.VarChar(40)
  requiresApproval      Boolean  @default(false)
  requiresIntegration   Boolean  @default(false)
  cacheTtlMinutes       Int      @default(0)
  isActive              Boolean  @default(true)
  configJson            Json     @default("{}")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  planLimits         PlanFeatureLimit[]
  usageEvents        UsageEvent[]
  providerCostEvents ProviderCostEvent[]
  cacheRecords       CacheRecord[]
  jobQueueRecords    JobQueueRecord[]
  modelRoutingRules  ModelRoutingRule[]

  @@index([moduleName])
  @@index([isActive])
}

model PlanFeatureLimit {
  id             String             @id @default(cuid())
  planCode       String             @db.VarChar(40)
  featureKey     String             @db.VarChar(120)
  feature        FeatureCostCatalog @relation(fields: [featureKey], references: [featureKey], onDelete: Cascade)
  monthlyLimit   Int?
  dailyLimit     Int?
  creditCost     Int?
  hardBlocked    Boolean            @default(false)
  overageAllowed Boolean            @default(false)
  configJson     Json               @default("{}")
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([planCode, featureKey])
  @@index([planCode])
  @@index([featureKey])
}

model CreditAccount {
  id               String   @id @default(cuid())
  clientId         String
  client           Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  balance          Int      @default(0)
  monthlyAllowance Int      @default(0)
  monthlyUsed      Int      @default(0)
  periodStart      DateTime
  periodEnd        DateTime
  status           String   @default("active") @db.VarChar(40)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([clientId, periodStart])
  @@index([clientId, status])
  @@index([periodEnd])
}

model CreditTransaction {
  id           String      @id @default(cuid())
  clientId     String
  client       Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  usageEventId String?
  usageEvent   UsageEvent? @relation(fields: [usageEventId], references: [id], onDelete: SetNull)
  type         String      @db.VarChar(40) // grant | debit | refund | adjustment | expiry
  amount       Int
  balanceAfter Int
  reason       String      @db.VarChar(255)
  metadataJson Json        @default("{}")
  createdAt    DateTime    @default(now())

  @@index([clientId, createdAt])
  @@index([usageEventId])
  @@index([type])
}

model UsageEvent {
  id                     String             @id @default(cuid())
  clientId               String
  client                 Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId                 String?
  projectId              String?
  websiteId              String?
  featureKey             String             @db.VarChar(120)
  feature                FeatureCostCatalog @relation(fields: [featureKey], references: [featureKey], onDelete: Restrict)
  actionKey              String             @db.VarChar(160)
  idempotencyKey         String?            @db.VarChar(255)
  status                 String             @default("reserved") @db.VarChar(40)
  creditsReserved        Int                @default(0)
  creditsCommitted       Int                @default(0)
  providerCostUsd        Float              @default(0)
  inputUnits             Int                @default(1)
  approvalTokenHash      String?            @unique @db.VarChar(191)
  approvalTokenExpiresAt DateTime?
  error                  String?            @db.Text
  metadataJson           Json               @default("{}")
  createdAt              DateTime           @default(now())
  committedAt            DateTime?
  refundedAt             DateTime?

  creditTransactions CreditTransaction[]
  providerCostEvents ProviderCostEvent[]

  @@unique([clientId, idempotencyKey])
  @@index([clientId, createdAt])
  @@index([featureKey, status])
  @@index([projectId])
  @@index([websiteId])
  @@index([status])
}

model ProviderCostEvent {
  id           String             @id @default(cuid())
  clientId     String
  client       Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  usageEventId String?
  usageEvent   UsageEvent?        @relation(fields: [usageEventId], references: [id], onDelete: SetNull)
  featureKey   String             @db.VarChar(120)
  feature      FeatureCostCatalog @relation(fields: [featureKey], references: [featureKey], onDelete: Restrict)
  provider     String             @db.VarChar(80)
  model        String?            @db.VarChar(120)
  inputTokens  Int                @default(0)
  outputTokens Int                @default(0)
  costUsd      Float              @default(0)
  metadataJson Json               @default("{}")
  createdAt    DateTime           @default(now())

  @@index([clientId, createdAt])
  @@index([usageEventId])
  @@index([featureKey])
  @@index([provider])
}

model CacheRecord {
  id           String             @id @default(cuid())
  clientId     String
  client       Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  featureKey   String             @db.VarChar(120)
  feature      FeatureCostCatalog @relation(fields: [featureKey], references: [featureKey], onDelete: Cascade)
  cacheKeyHash String             @db.VarChar(191)
  sourceHash   String?            @db.VarChar(191)
  resultJson   Json               @default("{}")
  expiresAt    DateTime
  hitCount     Int                @default(0)
  lastHitAt    DateTime?
  createdAt    DateTime           @default(now())

  @@unique([clientId, featureKey, cacheKeyHash])
  @@index([expiresAt])
  @@index([featureKey])
}

model BudgetCap {
  id             String   @id @default(cuid())
  clientId       String
  client         Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  scope          String   @db.VarChar(40) // workspace | project | feature | provider
  scopeKey       String   @db.VarChar(191)
  monthlyCredits Int?
  monthlyCostUsd Float?
  isActive       Boolean  @default(true)
  alertAtPercent Int      @default(80)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([clientId, scope, scopeKey])
  @@index([clientId, isActive])
}

model UsageAlert {
  id           String    @id @default(cuid())
  clientId     String
  client       Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  alertType    String    @db.VarChar(80)
  severity     String    @default("info") @db.VarChar(40)
  message      String    @db.Text
  metadataJson Json      @default("{}")
  resolvedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([clientId, createdAt])
  @@index([alertType])
  @@index([resolvedAt])
}

model JobQueueRecord {
  id               String             @id @default(cuid())
  clientId         String
  featureKey       String             @db.VarChar(120)
  feature          FeatureCostCatalog @relation(fields: [featureKey], references: [featureKey], onDelete: Restrict)
  projectId        String?
  websiteId        String?
  status           String             @default("queued") @db.VarChar(40)
  priority         Int                @default(50)
  payloadJson      Json               @default("{}")
  approvalRequired Boolean            @default(false)
  runAfter         DateTime?
  startedAt        DateTime?
  completedAt      DateTime?
  error            String?            @db.Text
  createdAt        DateTime           @default(now())

  @@index([clientId, status])
  @@index([featureKey])
  @@index([runAfter])
}

model ModelRoutingRule {
  id              String             @id @default(cuid())
  featureKey      String             @db.VarChar(120)
  feature         FeatureCostCatalog @relation(fields: [featureKey], references: [featureKey], onDelete: Cascade)
  planCode        String?            @db.VarChar(40)
  taskComplexity  String             @default("standard") @db.VarChar(40)
  provider        String             @default("openai") @db.VarChar(80)
  model           String             @db.VarChar(120)
  maxInputTokens  Int?
  maxOutputTokens Int?
