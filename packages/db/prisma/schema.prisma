  bestPageId        String?
  weakPageCount     Int       @default(0)
  cannibalRiskCount Int       @default(0)
  createdAt         DateTime  @default(now())
  completedAt       DateTime?

  pages KeywordAuditPage[]

  @@index([websiteId])
  @@index([crawlJobId])
