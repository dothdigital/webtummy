// SEO + AI Search crawler — data model.
// See docs/ARCHITECTURE.md §9. MySQL 8+ / Prisma.
//
// MySQL notes vs the Postgres draft:
//  - No native array columns -> string lists are stored as JSON.
//  - Indexed URL columns are VARCHAR(512) (InnoDB index key-length limit with
//    utf8mb4 is ~3072 bytes; cuid + 512-char url fits). Non-indexed long text
//    uses @db.Text. URLs > 512 chars are rare; dedup key truncates -> acceptable MVP.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── Auth + tenancy (RBAC) ────────────────────────────────────────────────────
//
// Roles:
//  - super_admin : SEnuke AI staff. No clientId. Creates clients + client users,
//                  sees everything across all tenants.
//  - client_admin: belongs to one Client. Manages that client's websites, crawls,
//                  reports, and can invite client_users in the same client.
//  - client_user : belongs to one Client. Can run crawls + view reports, no user mgmt.
//
// Tenant isolation: every Website (and everything under it) is reached via clientId.
// Non-super_admin queries MUST be scoped to the user's clientId in the API layer.

enum Role {
  super_admin
  client_admin
  client_user
}

model User {
  id                      String                   @id @default(cuid())
  email                   String                   @unique
  passwordHash            String
  name                    String?
  role                    Role                     @default(client_user)
  // null for super_admin; required for client_* roles.
  clientId                String?
  client                  Client?                  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  isActive                Boolean                  @default(true)
  emailVerifiedAt         DateTime?
  lastLoginAt             DateTime?
  createdAt               DateTime                 @default(now())
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]

  @@index([clientId])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Client {
  id                    String                @id @default(cuid())
  name                  String
  contactEmail          String?
  plan                  String                @default("mini")
  aiSubscriptionStatus  String                @default("active")
  stripeCustomerId      String?
  stripeSubscriptionId  String?
  trialStartedAt        DateTime?
  trialEndsAt           DateTime?
  manualAccessEndsAt    DateTime?
  graceEndsAt           DateTime?
  subscriptionSource    String                @default("trial") @db.VarChar(40)
  offlineAutoRenew      Boolean               @default(false)
  offlineNextRenewalAt  DateTime?
  subscriptionCurrentPeriodEnd DateTime?
  trialEndingSoonNotifiedAt DateTime?
  trialExpiredNotifiedAt DateTime?
  paymentFailedNotifiedAt DateTime?
  manualAccessEndingSoonNotifiedAt DateTime?
  manualAccessExpiredNotifiedAt DateTime?
  subscriptionExpiringSoonNotifiedAt DateTime?
  reportEmailEnabled Boolean               @default(true)
  weeklyReportEmailEnabled Boolean         @default(true)
  monthlyReportEmailEnabled Boolean        @default(true)
  rankingChangeEmailEnabled Boolean        @default(true)
  lastWeeklyReportAt DateTime?
  lastMonthlyUsageResetAt DateTime?
  lastMonthlyAuditAt DateTime?
  lastMonthlyReportAt DateTime?
  activeWebsiteLimit    Int                   @default(1)
  extraWebsiteSlots     Int                   @default(0)
  lastWebsiteReplacementAt DateTime?
  isActive              Boolean               @default(true)
  createdAt             DateTime              @default(now())
  websites              Website[]
  users                 User[]
  keywordResearchRuns   KeywordResearchRun[]
  aiContentGenerations  AiContentGeneration[]
  aiUsageCounters       AiUsageCounter[]
  localBusinessProfiles LocalBusinessProfile[]
  offlinePayments       OfflinePayment[]
  monthlyReports        MonthlyClientReport[]
  executionTasks        ExecutionTask[]
  projects              Project[]

  @@index([plan])
  @@index([aiSubscriptionStatus, manualAccessEndsAt])
  @@index([stripeCustomerId])
}

model OfflinePayment {
  id                 String   @id @default(cuid())
  clientId           String
  client             Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  amountCents        Int
  method             String   @db.VarChar(80)
  duration           String   @db.VarChar(20)
  reference          String?  @db.VarChar(255)
  notes              String?  @db.Text
  autoRenew          Boolean  @default(false)
  subscriptionEndsAt DateTime
  nextRenewalAt      DateTime?
  status             String   @default("recorded") @db.VarChar(40)
  createdAt          DateTime @default(now())

  @@index([clientId, createdAt])
  @@index([subscriptionEndsAt])
}

model MonthlyClientReport {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  periodStart DateTime
  status      String   @default("ready") @db.VarChar(40)
  summaryJson Json     @default("{}")
  emailSentAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([clientId, periodStart])
  @@index([periodStart])
}

model MaintenanceRun {
  id          String   @id @default(cuid())
  jobKey      String   @db.VarChar(120)
  status      String   @db.VarChar(40)
  startedAt   DateTime @default(now())
  finishedAt  DateTime?
  detailsJson Json     @default("{}")
  error       String?  @db.Text

  @@index([jobKey, startedAt])
  @@index([status])
}

model BillingPlan {
  id                 String   @id @default(cuid())
  code               String   @unique @db.VarChar(40)
  name               String   @db.VarChar(80)
  description        String   @db.Text
  priceMonthlyCents  Int
  articleLimit       Int
  helperMonthlyLimit Int      @default(1000)
  features           Json     @default("[]")
  stripeProductId    String?  @db.VarChar(255)
  stripePriceId      String?  @db.VarChar(255)
  isActive           Boolean  @default(true)
  sortOrder          Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@index([stripeProductId])
  @@index([stripePriceId])
}

model Website {
  id                  String                 @id @default(cuid())
  clientId            String
  client              Client                 @relation(fields: [clientId], references: [id], onDelete: Cascade)
  domain              String                 @db.VarChar(255)
  rootUrl             String                 @db.VarChar(512)
  status              String                 @default("active") @db.VarChar(40)
  archivedAt          DateTime?
  targetCountry       String?
  targetCities        Json                   @default("[]")
  // Owned-site override allows ignoring robots.txt (Phase 2: requires verification).
  verifiedOwned       Boolean                @default(false)
  createdAt           DateTime               @default(now())
  crawlJobs           CrawlJob[]
  keywordAudits       KeywordAuditCampaign[]
  keywordResearchRuns KeywordResearchRun[]
  socialProfiles      SocialProfile[]
  socialCompetitors   SocialCompetitorProfile[]
  socialStrategies    SocialStrategy[]
  localBusinessProfiles LocalBusinessProfile[]
  executionTasks        ExecutionTask[]
  projects              Project[]

  @@index([clientId])
  @@index([clientId, status])
}

// ─── Guided Project Foundation ──────────────────────────────────────────────

model Project {
  id                        String                @id @default(cuid())
  clientId                  String
  client                    Client                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  websiteId                 String?
  website                   Website?              @relation(fields: [websiteId], references: [id], onDelete: SetNull)
  name                      String                @db.VarChar(180)
  projectType               String                @default("existing_website") @db.VarChar(60)
  status                    String                @default("active") @db.VarChar(40)
  currentStep               String                @default("intake") @db.VarChar(80)
  businessName              String?               @db.VarChar(180)
  websiteUrl                String?               @db.VarChar(512)
  niche                     String?               @db.VarChar(180)
  targetLocation            String?               @db.VarChar(180)
  primaryGoal               String?               @db.VarChar(255)
  targetLaunchTimeline      String?               @db.VarChar(80)
  preferredOutputs          Json                  @default("[]")
  preferredPublishingMethod String?               @db.VarChar(80)
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @updatedAt

  intakeAnswers   ProjectIntakeAnswer[]
  businessProfile BusinessProfile?
  aiRuns          AiRun[]
  executionPlans  ExecutionPlan[]
  opportunities   Opportunity[]
  strategyPlans   StrategyPlan[]
  executionTasks  ExecutionTask[]
  workflowSteps   ProjectWorkflowStep[]
  growthDiagnoses GrowthDiagnosis[]
  growthFunnelStages GrowthFunnelStage[]
  growthExperiments GrowthExperiment[]
  growthChannelTests GrowthChannelTest[]
  growthReports GrowthReport[]

  @@index([clientId, status])
  @@index([websiteId])
  @@index([currentStep])
}

model ProjectWorkflowStep {
  id                String    @id @default(cuid())
  projectId         String
  project           Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stepKey           String    @db.VarChar(80)
  title             String    @db.VarChar(180)
  description       String    @db.Text
  status            String    @default("pending") @db.VarChar(60)
  priority          String    @default("medium") @db.VarChar(20)
  actionLabel       String?   @db.VarChar(120)
  actionUrl         String?   @db.VarChar(512)
  sortOrder         Int       @default(0)
  sourceType        String?   @db.VarChar(80)
  sourceId          String?   @db.VarChar(191)
  completionReason  String?   @db.Text
  readyReason       String?   @db.Text
  blockedReason     String?   @db.Text
  completedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([projectId, stepKey])
  @@index([projectId, status])
  @@index([stepKey])
  @@index([sortOrder])
}

model ProjectIntakeAnswer {
  id            String   @id @default(cuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  questionKey   String   @db.VarChar(120)
  questionText  String   @db.Text
  answerValue   Json     @default("{}")
  answerType    String   @default("text") @db.VarChar(40)
  moduleContext String   @default("core_intake") @db.VarChar(80)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([projectId, questionKey])
  @@index([projectId])
}

model BusinessProfile {
  id              String   @id @default(cuid())
  projectId       String   @unique
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  businessSummary String?  @db.Text
  targetAudience  String?  @db.Text
  offerSummary    String?  @db.Text
  businessModel   String?  @db.VarChar(120)
  strengths       Json     @default("[]")
  constraints     Json     @default("[]")
  budgetLevel     String?  @db.VarChar(80)
  skillLevel      String?  @db.VarChar(80)
  tonePreference  String?  @db.VarChar(80)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model AiRun {
  id                String   @id @default(cuid())
  projectId         String?
  project           Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  clientId          String?
  moduleName        String   @db.VarChar(80)
  promptVersion     String   @db.VarChar(80)
  inputSnapshotJson Json     @default("{}")
  outputJson        Json     @default("{}")
  outputText        String?  @db.Text
  status            String   @default("completed") @db.VarChar(40)
  tokenUsage        Json     @default("{}")
  costEstimateUsd   Float?
  errorMessage      String?  @db.Text
  createdAt         DateTime @default(now())

  @@index([projectId, createdAt])
  @@index([clientId, createdAt])
  @@index([moduleName, status])
}

model ExecutionPlan {
  id        String          @id @default(cuid())
  projectId String
  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title     String          @db.VarChar(180)
  summary   String?         @db.Text
  status    String          @default("active") @db.VarChar(40)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  tasks ExecutionTask[]

  @@index([projectId, status])
}

model Opportunity {
  id                  String   @id @default(cuid())
  projectId           String
  project             Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name                String   @db.VarChar(180)
  targetAudience      String?  @db.Text
  problemSolved       String?  @db.Text
  recommendedOffer    String?  @db.Text
  businessModel       String?  @db.VarChar(120)
  opportunityScore    Int?
  seoScore            Int?
  competitionScore    Int?
  monetizationScore   Int?
  executionScore      Int?
  userFitScore        Int?
  summary             String?  @db.Text
  status              String   @default("suggested") @db.VarChar(40)
  createdAt           DateTime @default(now())

  strategyPlans StrategyPlan[]

  @@index([projectId, status])
}

model StrategyPlan {
  id                   String       @id @default(cuid())
  projectId            String
  project              Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  opportunityId        String?
  opportunity          Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  strategySummary      String?      @db.Text
  positioningStatement String?      @db.Text
  audienceProfile      String?      @db.Text
  offerRecommendation  String?      @db.Text
  businessModel        String?      @db.VarChar(120)
  seoStrategy          String?      @db.Text
  aiCitationStrategy   String?      @db.Text
  contentStrategy      String?      @db.Text
  authorityStrategy    String?      @db.Text
  socialStrategy       String?      @db.Text
  publishingStrategy   String?      @db.Text
  status               String       @default("draft") @db.VarChar(40)
  approvedAt           DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@index([projectId, status])
  @@index([opportunityId])
}

// ─── Crawl run ───────────────────────────────────────────────────────────────

enum CrawlStatus {
  queued
  running
  completed
  failed
}

model CrawlJob {
  id           String      @id @default(cuid())
  websiteId    String
  website      Website     @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  status       CrawlStatus @default(queued)
  // Snapshot of the options used for this run.
  options      Json        @default("{}")
  pageLimit    Int         @default(500)
  maxDepth     Int         @default(10)
  pagesCrawled Int         @default(0)
  errorCount   Int         @default(0)
  siteScore    Int? // 0-100, set on completion
  startedAt    DateTime?
  completedAt  DateTime?
  error        String?     @db.Text
  createdAt    DateTime    @default(now())

  pages       Page[]
  sitemaps    Sitemap[]
  robotsFiles RobotsFile[]
  llmsFiles   LlmsFile[]
  issues      Issue[]
  reports     Report[]

  @@index([websiteId])
  @@index([status])
}

// ─── Page-level results ──────────────────────────────────────────────────────

model Page {
  id                        String   @id @default(cuid())
  crawlJobId                String
  crawlJob                  CrawlJob @relation(fields: [crawlJobId], references: [id], onDelete: Cascade)
  url                       String   @db.Text // as discovered (fetch url)
  normalizedUrl             String   @db.VarChar(512) // dedup key
  finalUrl                  String?  @db.Text // after redirects
  statusCode                Int?
  contentType               String?
  wordCount                 Int?
  depth                     Int      @default(0)
  responseTimeMs            Int?
  redirectChain             Json     @default("[]")
  // populated in the post-crawl graph pass
  inlinkCount               Int      @default(0)
  outlinkCount              Int      @default(0)
  internalLinkScore         Int?
  internalLinkGrade         String?
  outgoingInternalLinkCount Int      @default(0)
  brokenInternalLinkCount   Int      @default(0)
  weakAnchorCount           Int      @default(0)
  isOrphan                  Boolean  @default(false)
  score                     Int? // 0-100 page score, computed in the post-crawl pass
  fetchError                String?  @db.Text
  createdAt                 DateTime @default(now())

  seo     PageSeo?
  links   Link[]
  images  Image[]
  assets  PageAsset[]
  schemas Schema[]
  issues  Issue[]

  @@unique([crawlJobId, normalizedUrl])
  @@index([crawlJobId, statusCode])
}

model PageSeo {
  id               String  @id @default(cuid())
  pageId           String  @unique
  page             Page    @relation(fields: [pageId], references: [id], onDelete: Cascade)
  title            String? @db.VarChar(512)
  titleLength      Int?
  metaDescription  String? @db.Text
  metaDescLength   Int?
  h1Count          Int     @default(0)
  h1Text           Json    @default("[]")
  h2Json           Json    @default("[]")
  canonicalUrl     String? @db.VarChar(512)
  robotsMeta       String?
  xRobotsTag       String?
  hreflangJson     Json    @default("[]")
  ampUrl           String? @db.VarChar(512)
  looksJsDependent Boolean @default(false)
  ogTags           Json    @default("{}")
  twitterTags      Json    @default("{}")
  // Phase 2: simhash fingerprint of visible content for near-dup detection.
  contentSimhash   BigInt?
}

model Link {
  id                  String  @id @default(cuid())
  sourcePageId        String
  sourcePage          Page    @relation(fields: [sourcePageId], references: [id], onDelete: Cascade)
  targetUrl           String  @db.Text
  targetUrlNormalized String  @db.VarChar(512)
  anchorText          String? @db.Text
  isInternal          Boolean @default(true)
  placement           String  @default("body") // header | footer | body | navigation
  targetStatus        Int?
  isBroken            Boolean @default(false)
  rel                 String? // nofollow etc.

  @@index([sourcePageId])
  @@index([targetUrlNormalized])
}

model Image {
  id         String  @id @default(cuid())
  pageId     String
  page       Page    @relation(fields: [pageId], references: [id], onDelete: Cascade)
  src        String  @db.Text
  alt        String? @db.Text
  width      Int?
  height     Int?
  statusCode Int?
  issueType  String? // missing_alt | empty_alt | broken | oversized

  @@index([pageId])
}

model PageAsset {
  id             String  @id @default(cuid())
  pageId         String
  page           Page    @relation(fields: [pageId], references: [id], onDelete: Cascade)
  url            String  @db.Text
  type           String // css | javascript | image
  renderBlocking Boolean @default(false)
  statusCode     Int?
  sizeBytes      Int?
  responseTimeMs Int?
  issueType      String?

  @@index([pageId])
  @@index([type])
}

model Schema {
  id         String  @id @default(cuid())
  pageId     String
  page       Page    @relation(fields: [pageId], references: [id], onDelete: Cascade)
  format     String // json-ld | microdata | rdfa
  schemaType String?
  rawJson    Json?
  validJson  Boolean @default(true)
  issueType  String? // missing_required_field etc. (Phase 2 validation)

  @@index([pageId])
}

// ─── Site-level snapshots ─────────────────────────────────────────────────────

model Sitemap {
  id         String       @id @default(cuid())
  crawlJobId String
  crawlJob   CrawlJob     @relation(fields: [crawlJobId], references: [id], onDelete: Cascade)
  sitemapUrl String       @db.VarChar(512)
  statusCode Int?
  urlCount   Int          @default(0)
  lastRead   DateTime     @default(now())
  urls       SitemapUrl[]

  @@index([crawlJobId])
}

model SitemapUrl {
  id         String  @id @default(cuid())
  sitemapId  String
  sitemap    Sitemap @relation(fields: [sitemapId], references: [id], onDelete: Cascade)
  url        String  @db.VarChar(512)
  lastmod    String?
  statusCode Int?
  inCrawl    Boolean @default(false) // set in post-crawl diff

  @@index([sitemapId])
}

model RobotsFile {
  id          String   @id @default(cuid())
  crawlJobId  String
  crawlJob    CrawlJob @relation(fields: [crawlJobId], references: [id], onDelete: Cascade)
  content     String?  @db.Text
  statusCode  Int?
  parsedRules Json     @default("{}")
  sitemapRefs Json     @default("[]")

  @@index([crawlJobId])
}

model LlmsFile {
  id           String   @id @default(cuid())
  crawlJobId   String
  crawlJob     CrawlJob @relation(fields: [crawlJobId], references: [id], onDelete: Cascade)
  content      String?  @db.Text
  statusCode   Int?
  sectionScore Int?

  @@index([crawlJobId])
}

// ─── Issues + reports ─────────────────────────────────────────────────────────

enum Severity {
  high
  medium
  low
}

model Issue {
  id             String   @id @default(cuid())
  crawlJobId     String
  crawlJob       CrawlJob @relation(fields: [crawlJobId], references: [id], onDelete: Cascade)
  pageId         String?
  page           Page?    @relation(fields: [pageId], references: [id], onDelete: Cascade)
  issueType      String // e.g. missing_title, duplicate_title, broken_internal_link
  category       String // indexability | onpage | links | media | schema | social | ai_readiness | performance
  severity       Severity
  weightImpact   Float    @default(0) // points deducted from score
  message        String   @db.Text
  recommendation String?  @db.Text
  status         String   @default("open") // open | fixed | ignored

  @@index([crawlJobId, severity])
  @@index([pageId, issueType])
}

model Report {
  id         String   @id @default(cuid())
  crawlJobId String
  crawlJob   CrawlJob @relation(fields: [crawlJobId], references: [id], onDelete: Cascade)
  format     String // pdf | docx
  fileUrl    String?  @db.Text
  createdAt  DateTime @default(now())

  @@index([crawlJobId])
}

// ─── Project Execution Builder ──────────────────────────────────────────────

model ExecutionTask {
  id                   String    @id @default(cuid())
  clientId             String
  client               Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  websiteId            String?
  website              Website?  @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  projectId            String?
  project              Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  executionPlanId      String?
  executionPlan        ExecutionPlan? @relation(fields: [executionPlanId], references: [id], onDelete: SetNull)
  moduleName           String    @db.VarChar(80)
  sourceType           String    @db.VarChar(80)
  sourceId             String?   @db.VarChar(191)
  dedupeKey            String    @unique @db.VarChar(255)
  title                String    @db.VarChar(255)
  description          String    @db.Text
  priority             String    @default("medium") @db.VarChar(20)
  automationLevel      String    @default("manual_guided") @db.VarChar(60)
  status               String    @default("ready") @db.VarChar(60)
  requiresApproval     Boolean   @default(false)
  requiresIntegration  Boolean   @default(false)
  manualRequired       Boolean   @default(true)
  safetyCategory       String    @default("safe") @db.VarChar(60)
  relatedModule        String?   @db.VarChar(80)
  approvalSnapshotJson Json      @default("{}")
  approvedAt           DateTime?
  blockedReason        String?   @db.Text
  actionButtonLabel    String?   @db.VarChar(120)
  relatedUrl           String?   @db.VarChar(512)
  relatedAssetId       String?   @db.VarChar(191)
  manualInstructions   String?   @db.Text
  impact               String?   @db.Text
  completedAt          DateTime?
  skippedAt            DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([clientId, status])
  @@index([projectId, status])
  @@index([executionPlanId])
  @@index([websiteId, status])
  @@index([moduleName])
  @@index([safetyCategory])
  @@index([priority])
  @@index([createdAt])
}

// ─── Growth Marketing Engine ────────────────────────────────────────────────

model GrowthDiagnosis {
  id             String   @id @default(cuid())
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  bottleneckType String   @db.VarChar(80)
  scoreJson      Json     @default("{}")
  summary        String   @db.Text
  dataSnapshot   Json     @default("{}")
  createdAt      DateTime @default(now())

  @@index([projectId, createdAt])
  @@index([bottleneckType])
}

model GrowthFunnelStage {
  id               String   @id @default(cuid())
  projectId        String
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stageKey         String   @db.VarChar(80)
  title            String   @db.VarChar(180)
  status           String   @default("needs_attention") @db.VarChar(60)
  conversionMetric String?  @db.VarChar(120)
  issueSummary     String?  @db.Text
  automationStatus String   @default("manual_guided") @db.VarChar(60)
  sortOrder        Int      @default(0)
  updatedAt        DateTime @updatedAt
  createdAt        DateTime @default(now())

  @@unique([projectId, stageKey])
  @@index([projectId, status])
  @@index([sortOrder])
}

model GrowthExperiment {
  id                String   @id @default(cuid())
  projectId         String
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title             String   @db.VarChar(220)
  hypothesis        String   @db.Text
  metric            String   @db.VarChar(160)
  successThreshold  String   @db.VarChar(220)
  status            String   @default("planned") @db.VarChar(60)
  iceScore          Int      @default(0)
  pieScore          Int      @default(0)
  impactScore       Int      @default(0)
  confidenceScore   Int      @default(0)
  easeScore         Int      @default(0)
  potentialScore    Int      @default(0)
  importanceScore   Int      @default(0)
  requiredAssets    Json     @default("[]")
  automationLevel   String   @default("prepare") @db.VarChar(60)
  requiresApproval  Boolean  @default(true)
  safetyCategory    String   @default("review_required") @db.VarChar(60)
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  assets  GrowthExperimentAsset[]
  results GrowthExperimentResult[]

  @@index([projectId, status])
  @@index([iceScore])
  @@index([pieScore])
}

model GrowthExperimentAsset {
  id             String           @id @default(cuid())
  experimentId   String
  experiment     GrowthExperiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  assetId        String?          @db.VarChar(191)
  assetType      String           @db.VarChar(80)
  title          String           @db.VarChar(220)
  approvalStatus String           @default("needs_review") @db.VarChar(60)
  contentJson    Json             @default("{}")
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([experimentId, approvalStatus])
  @@index([assetType])
}

model GrowthExperimentResult {
  id             String           @id @default(cuid())
  experimentId   String
  experiment     GrowthExperiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  baselineValue  Float?
  currentValue   Float?
  resultStatus   String           @default("tracking") @db.VarChar(60)
  notes          String?          @db.Text
  recordedAt     DateTime         @default(now())

  @@index([experimentId, recordedAt])
  @@index([resultStatus])
}

model GrowthChannelTest {
  id           String   @id @default(cuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  channel      String   @db.VarChar(80)
  cadence      String   @db.VarChar(120)
  metric       String   @db.VarChar(160)
  durationDays Int      @default(30)
  status       String   @default("planned") @db.VarChar(60)
  assetsNeeded Json     @default("[]")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([projectId, status])
  @@index([channel])
}

model GrowthReport {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  clientId    String?
  reportType  String   @db.VarChar(80)
  htmlContent String?  @db.Text
  pdfUrl      String?  @db.VarChar(512)
  status      String   @default("draft") @db.VarChar(60)
