  crawlJob     CrawlJob @relation(fields: [crawlJobId], references: [id], onDelete: Cascade)
  content      String?  @db.Text
  statusCode   Int?
  sectionScore Int?

  @@index([crawlJobId])
}

// ─── Issues + reports ─────────────────────────────────────────────────────────

enum Severity {
  high
  medium
  low
}

model Issue {
  id             String   @id @default(cuid())
  crawlJobId     String
  crawlJob       CrawlJob @relation(fields: [crawlJobId], references: [id], onDelete: Cascade)
  pageId         String?
  page           Page?    @relation(fields: [pageId], references: [id], onDelete: Cascade)
