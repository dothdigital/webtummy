// ─── Local SEO Presence ─────────────────────────────────────────────────────

model LocalBusinessProfile {
  id                       String   @id @default(cuid())
  clientId                 String
  client                   Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  websiteId                String?
  website                  Website? @relation(fields: [websiteId], references: [id], onDelete: SetNull)
  businessName             String   @db.VarChar(180)
  domain                   String   @db.VarChar(255)
  phone                    String   @db.VarChar(80)
  address                  String   @db.VarChar(255)
  city                     String   @db.VarChar(120)
  region                   String?  @db.VarChar(120)
  country                  String   @db.VarChar(120)
  postalCode               String?  @db.VarChar(40)
  mainCategory             String   @db.VarChar(160)
  services                 Json     @default("[]")
  targetLocations          Json     @default("[]")
  googleBusinessProfileUrl String?  @db.VarChar(512)
  googleAverageRating      Float?
  googleReviewCount        Int?
  latitude                 Float?
  longitude                Float?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  keywords        LocalKeyword[]
  competitors     LocalCompetitor[]
  reviews         LocalReview[]
  citations       LocalCitation[]
  scores          LocalScore[]
  recommendations LocalRecommendation[]

  @@index([clientId])
  @@index([websiteId])
  @@index([domain])
}

model LocalKeyword {
  id         String   @id @default(cuid())
  businessId String
  business   LocalBusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)
  keyword    String   @db.VarChar(255)
  city       String   @db.VarChar(120)
  country    String   @default("United States") @db.VarChar(120)
  device     String   @default("desktop") @db.VarChar(32)
  language   String   @default("en") @db.VarChar(16)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  snapshots   LocalRankSnapshot[]
  scores      LocalScore[]
  competitors LocalCompetitor[]

  @@index([businessId])
  @@index([keyword, city])
}

model LocalRankSnapshot {
  id                  String   @id @default(cuid())
  keywordId           String
  keyword             LocalKeyword @relation(fields: [keywordId], references: [id], onDelete: Cascade)
  scanDate            DateTime @default(now())
  organicPosition     Int?
  mapsPosition        Int?
  localPackPosition   Int?
  foundDomain         Boolean  @default(false)
  matchedBusinessName String?  @db.VarChar(180)
  confidenceScore     Int      @default(0)
  matchStatus         String   @default("no_reliable_match") @db.VarChar(40)
  rawResponseRef      String?  @db.VarChar(255)
  evidenceJson        Json     @default("{}")

  @@index([keywordId, scanDate])
}

model LocalCompetitor {
  id              String   @id @default(cuid())
  businessId      String
  business        LocalBusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)
  keywordId       String?
  keyword         LocalKeyword? @relation(fields: [keywordId], references: [id], onDelete: SetNull)
  competitorName  String   @db.VarChar(180)
  domain          String?  @db.VarChar(255)
  phone           String?  @db.VarChar(80)
  address         String?  @db.VarChar(255)
  rating          Float?
  reviewCount     Int?
  mapsPosition    Int?
  organicPosition Int?
  categoriesJson  Json     @default("[]")
  evidenceJson    Json     @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([businessId])
  @@index([keywordId])
  @@index([domain])
}

model LocalReview {
  id          String   @id @default(cuid())
  businessId  String
  business    LocalBusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)
  source      String   @db.VarChar(80)
  reviewer    String?  @db.VarChar(180)
  rating      Float?
  reviewText  String?  @db.Text
  reviewDate  DateTime?
  sentiment   String?  @db.VarChar(40)
  replyStatus String   @default("not_replied") @db.VarChar(40)
  createdAt   DateTime @default(now())

  @@index([businessId])
  @@index([source])
  @@index([reviewDate])
}

model LocalCitation {
  id           String   @id @default(cuid())
  businessId   String
  business     LocalBusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)
  source       String   @db.VarChar(120)
  found        Boolean  @default(false)
  nameMatch    Boolean  @default(false)
  phoneMatch   Boolean  @default(false)
  addressMatch Boolean  @default(false)
  websiteMatch Boolean  @default(false)
  status       String   @default("missing") @db.VarChar(40)
  fixUrl       String?  @db.VarChar(512)
  notes        String?  @db.Text
  checkedAt    DateTime @default(now())

  @@unique([businessId, source])
  @@index([businessId])
}

model LocalScore {
  id            String   @id @default(cuid())
  businessId    String
  business      LocalBusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)
  keywordId     String?
  keyword       LocalKeyword? @relation(fields: [keywordId], references: [id], onDelete: SetNull)
  scoreDate     DateTime @default(now())
  totalScore    Int
  organicScore  Int      @default(0)
  mapsScore     Int      @default(0)
  packScore     Int      @default(0)
  reviewScore   Int      @default(0)
  napScore      Int      @default(0)
  websiteScore  Int      @default(0)
  contentScore  Int      @default(0)
  statusLabel   String   @db.VarChar(40)
  evidenceJson  Json     @default("{}")

  @@index([businessId, scoreDate])
  @@index([keywordId, scoreDate])
}

model LocalRecommendation {
  id             String   @id @default(cuid())
  businessId     String
  business       LocalBusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)
  priority       String   @db.VarChar(20)
  category       String   @db.VarChar(80)
  recommendation String   @db.Text
  expectedImpact String?  @db.Text
  status         String   @default("open") @db.VarChar(40)
  evidenceJson   Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([businessId, status])
  @@index([priority])
}

model ExternalApiCache {
  id           String   @id @default(cuid())
  provider     String   @db.VarChar(80)
  endpoint     String   @db.VarChar(180)
  cacheKey     String   @unique @db.VarChar(255)
  requestJson  Json     @default("{}")
  responseJson Json     @default("{}")
  status       String   @default("ok") @db.VarChar(40)
  fetchedAt    DateTime @default(now())
  expiresAt    DateTime

  @@index([provider, endpoint])
  @@index([expiresAt])
}

