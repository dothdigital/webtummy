# Copy to .env.dev for the staging/dev deployment.
# Keep these values separate from production .env.

MYSQL_ROOT_PASSWORD="change-me-dev-root"
MYSQL_PASSWORD="change-me-dev-app"

# API
API_PORT=4000
JWT_SECRET="change-me-to-a-long-random-dev-string"
JWT_IDLE_TIMEOUT="8h"
WEB_APP_URL="https://doth-dev.webtummy.com"
PUBLIC_API_URL="https://doth-dev.webtummy.com"
SEED_ADMIN_EMAIL="admin-dev@webtummy.com"
SEED_ADMIN_PASSWORD="change-me-before-starting-staging"

# Email delivery. Use sandbox/test credentials for staging.
EMAIL_PROVIDER=""
EMAIL_FROM="Webtummy Dev <no-reply@example.com>"
SIGNUP_NOTIFY_EMAIL="inf@dothdigital.com"
RESEND_API_KEY=""
SES_MAILER_ACCESS_KEY=""
SES_MAILER_SECRET_KEY=""
SES_MAILER_AWS_REGION=""

# Google reCAPTCHA v3 for registration. Empty keys disable captcha enforcement.
RECAPTCHA_SITE_KEY=""
RECAPTCHA_SECRET_KEY=""
RECAPTCHA_MIN_SCORE=0.5
RECAPTCHA_BYPASS_LOCAL=true

# Crawler defaults (overridable per crawl)
CRAWL_DEFAULT_MAX_PAGES=100
CRAWL_DEFAULT_MAX_DEPTH=5
KEYWORD_RESEARCH_BATCH_MAX_CHECKS=100
KEYWORD_RESEARCH_PROJECT_ACTIVE_LIMIT=120
KEYWORD_RESEARCH_GLOBAL_ACTIVE_LIMIT=500
KEYWORD_RESEARCH_CONCURRENCY=3
CRAWL_FETCH_CONCURRENCY=3
CRAWL_REQUEST_TIMEOUT_MS=15000
CRAWL_MAX_REDIRECTS=5
CRAWL_USER_AGENT="Webtummy-Dev-Crawler/0.1 (+https://doth-dev.webtummy.com/bot)"

# External APIs. Use dev/test keys where available.
PAGESPEED_API_KEY=""
SEARCH_DATA_PROVIDER_LOGIN=""
SEARCH_DATA_PROVIDER_PASSWORD=""
SEARCH_DATA_PROVIDER_AUTH_BASE64=""

# AI Content Studio
OPENAI_API_KEY=
# Private generated images and PDF exports. Prefer the staging server IAM role.
AWS_REGION=ca-central-1
S3_ASSETS_BUCKET=
S3_UPLOAD_PREFIX=staging
S3_PRESIGN_TTL_SECONDS=300
S3_ASSETS_REQUIRED=true
S3_KMS_KEY_ID=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
# Use these only if no IAM role/profile is available.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
JVZOO_SECRET_KEY=
JVZOO_PREVIOUS_SECRET_KEY=
JVZOO_CUSTOMER_PORTAL_URL=https://customer.jvzoo.com/
OPENAI_RESEARCH_MODEL=gpt-5.6-luna
OPENAI_CONTENT_MODEL=gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini
OPENAI_SEARCH_MODEL=gpt-5.6-luna
# Per worker process. Total active website jobs = this value × worker replicas.
# Each content job may make up to three section calls concurrently.
WEBSITE_BUILDER_CONCURRENCY=2
# Global BullMQ start-rate guard. Tune below the provider RPM/TPM allowance.
WEBSITE_BUILDER_JOBS_PER_MINUTE=60

# Stripe billing. Use Stripe test mode keys only.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Continuous Growth Intelligence worker defaults
GROWTH_INTELLIGENCE_CONCURRENCY=8
GROWTH_INTELLIGENCE_JOBS_PER_MINUTE=120
GROWTH_INTELLIGENCE_SCHEDULE_INTERVAL_MS=60000
GROWTH_INTELLIGENCE_SCHEDULE_BATCH_SIZE=250
GROWTH_INTELLIGENCE_DEBOUNCE_MS=1800000

# Dot H Social Connect
SOCIAL_CONNECT_BASE_URL="https://api.dothdigital.com"
SOCIAL_CONNECT_API_KEY=""
SOCIAL_CONNECT_APP_KEY=""
SOCIAL_CONNECT_MASTER_API_KEY=""
