# Copy to .env and adjust. Loaded by api + worker.
# PostgreSQL used by Docker Compose. Use a URI-safe value because the same
# password is interpolated into DATABASE_URL (for example: openssl rand -hex 32).
POSTGRES_PASSWORD="replace-with-a-strong-uri-safe-password"
# Local non-Docker Prisma connection.
DATABASE_URL="postgresql://crawler:crawler@localhost:5432/crawler"
REDIS_URL="redis://localhost:6379"

# API
API_PORT=4000
JWT_SECRET="change-me-to-a-long-random-string"
APP_ENCRYPTION_KEY="change-me-to-a-separate-long-random-string"
JWT_IDLE_TIMEOUT="8h"
WEB_APP_URL="http://localhost:5173"
# Public HTTPS origin used by downloaded static-site contact forms.
PUBLIC_API_URL="http://localhost:4000"

# Email delivery. Set EMAIL_PROVIDER=ses for AWS SES, or set RESEND_API_KEY for Resend.
EMAIL_PROVIDER=""
EMAIL_FROM="SEnuke AI - AI Growth Operating System <no-reply@senuke.com>"
SUPPORT_EMAIL="info@dothdigital.com"
SIGNUP_NOTIFY_EMAIL="inf@dothdigital.com"
RESEND_API_KEY=""
SES_MAILER_ACCESS_KEY=""
SES_MAILER_SECRET_KEY=""
SES_MAILER_AWS_REGION=""

# Google reCAPTCHA v3 for registration. Empty keys disable captcha enforcement.
RECAPTCHA_SITE_KEY=""
RECAPTCHA_SECRET_KEY=""
RECAPTCHA_MIN_SCORE=0.5
RECAPTCHA_BYPASS_LOCAL=true

# Crawler defaults (overridable per crawl)
CRAWL_DEFAULT_MAX_PAGES=500
CRAWL_DEFAULT_MAX_DEPTH=10
KEYWORD_RESEARCH_BATCH_MAX_CHECKS=100
KEYWORD_RESEARCH_PROJECT_ACTIVE_LIMIT=120
KEYWORD_RESEARCH_GLOBAL_ACTIVE_LIMIT=500
KEYWORD_RESEARCH_CONCURRENCY=3
CRAWL_FETCH_CONCURRENCY=5
CRAWL_REQUEST_TIMEOUT_MS=15000
CRAWL_MAX_REDIRECTS=5
CRAWL_USER_AGENT="DotH-SEO-Crawler/0.1 (+https://dothdigital.example/bot)"

# External APIs
PAGESPEED_API_KEY=""
SEARCH_DATA_PROVIDER_LOGIN=""
SEARCH_DATA_PROVIDER_PASSWORD=""
SEARCH_DATA_PROVIDER_AUTH_BASE64=""

# Google Business Profile Limited V1 (DEV-051). Create a Google Cloud OAuth
# web client and register:
# http://localhost:4000/api/integrations/google-business-profile/callback
GOOGLE_BUSINESS_PROFILE_CLIENT_ID=""
GOOGLE_BUSINESS_PROFILE_CLIENT_SECRET=""
# Keep false until Google API access, third-party policy, and action testing are approved.
GOOGLE_BUSINESS_PROFILE_WRITES_ENABLED=false

# S3 / MinIO (Phase 2 — report + HTML storage)
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="crawler"
S3_SECRET_KEY="crawler123"
S3_BUCKET="crawler"

# AI Content Studio
OPENAI_API_KEY=
# Configure JVZIPN Complete Processing to POST to:
# https://<api-host>/api/integrations/jvzoo/ipn
JVZOO_SECRET_KEY=
# Optional previous key used only during a controlled signing-secret rotation.
JVZOO_PREVIOUS_SECRET_KEY=
JVZOO_CUSTOMER_PORTAL_URL=https://customer.jvzoo.com/
# Stronger model for research, evidence synthesis, opportunity and strategy decisions.
OPENAI_RESEARCH_MODEL=gpt-5.6-luna
# Cost-efficient model for approved content, website pages, lead magnets and social assets.
OPENAI_CONTENT_MODEL=gpt-4o-mini
# Backward-compatible aliases. New deployments should use the two variables above.
OPENAI_MODEL=gpt-4o-mini
OPENAI_SEARCH_MODEL=gpt-5.6-luna
OPENAI_IMAGE_MODEL=gpt-image-2
# Website images default to high quality. Set medium only when a workspace deliberately prioritizes lower generation cost.
WEBSITE_IMAGE_QUALITY=high
# Per worker process. Total active website jobs = this value × worker replicas.
# Each content job may make up to three section calls concurrently.
WEBSITE_BUILDER_CONCURRENCY=2
# Global BullMQ start-rate guard. Tune below the provider RPM/TPM allowance.
WEBSITE_BUILDER_JOBS_PER_MINUTE=60

# Stripe billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Dot H Social Connect
SOCIAL_CONNECT_BASE_URL="https://api.dothdigital.com"
SOCIAL_CONNECT_API_KEY=""
SOCIAL_CONNECT_APP_KEY=""
SOCIAL_CONNECT_MASTER_API_KEY=""
