# Copy to .env and adjust. Loaded by api + worker.
# MySQL. NOTE: special chars in the password must be URL-encoded (# -> %23).
DATABASE_URL="mysql://root:D0th%23123@localhost:3306/crawller"
REDIS_URL="redis://localhost:6379"

# API
API_PORT=4000
JWT_SECRET="change-me-to-a-long-random-string"
WEB_APP_URL="http://localhost:5173"

# Email delivery. Set EMAIL_PROVIDER=ses for AWS SES, or set RESEND_API_KEY for Resend.
EMAIL_PROVIDER=""
EMAIL_FROM="SEnuke AI <no-reply@senuke.com>"
SIGNUP_NOTIFY_EMAIL="inf@dothdigital.com"
RESEND_API_KEY=""
SES_MAILER_ACCESS_KEY=""
SES_MAILER_SECRET_KEY=""
SES_MAILER_AWS_REGION=""

# Google reCAPTCHA v3 for registration. Empty keys disable captcha enforcement.
RECAPTCHA_SITE_KEY=""
RECAPTCHA_SECRET_KEY=""
RECAPTCHA_MIN_SCORE=0.5

# Crawler defaults (overridable per crawl)
CRAWL_DEFAULT_MAX_PAGES=500
CRAWL_DEFAULT_MAX_DEPTH=10
CRAWL_FETCH_CONCURRENCY=5
CRAWL_REQUEST_TIMEOUT_MS=15000
CRAWL_MAX_REDIRECTS=5
CRAWL_USER_AGENT="DotH-SEO-Crawler/0.1 (+https://dothdigital.example/bot)"

# External APIs
PAGESPEED_API_KEY=""
SEARCH_DATA_PROVIDER_LOGIN=""
SEARCH_DATA_PROVIDER_PASSWORD=""
SEARCH_DATA_PROVIDER_AUTH_BASE64=""

# S3 / MinIO (Phase 2 — report + HTML storage)
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="crawler"
S3_SECRET_KEY="crawler123"
S3_BUCKET="crawler"

# AI Content Studio
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Stripe billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
